back": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment. ", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn3le08ob08re2aud01", "coverimg": "engenn3le08ob08re2img05.jpg", "images": [{"image": "engenn3le08ob08re2img05.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn3le08ob08re2img05.jpg", "text": "<span class=\"strong notdialogue\">Title: Saying Goodbye</span><br><br>Saying goodbye to friends is hard. My trip is only a couple days away. Don't get me wrong, I'm really getting excited about traveling to Europe. Last night, I printed out the full itinerary.  I realized that I would be away from my friends and my cat Meenee for a long time.", "time": "100", "id": 1}, {"image": "engenn3le08ob08re2img01.jpg", "text": "My friends and I had a lovely dinner together a couple nights ago. I was thinking about all the times we watched movies together, had coffees at Ned's Cafe and hung out.  The best thing about traveling is seeing new places and meeting new people. The worst thing is missing the ones you care about.", "time": "25000", "id": 2}, {"image": "engenn3le08ob08re2img01.jpg", "text": "We made some great memories over the last five years. I already miss them and I haven't even left yet.<br><br>What do you think? Send me a comment.<br><br>Bye for now.", "ti